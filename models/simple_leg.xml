<mujoco model="simple_leg">
  <compiler angle="degree"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <geom rgba="0.7 0.7 0.7 1" contype="1" conaffinity="1"/>
    <joint damping="0.2"/>
  </default>

  <worldbody>
    <light diffuse="1 1 1" pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" solref="0.02 1" rgba="0.8 0.9 0.8 1"/>

    <body name="base" pos="0 0 1.6">
      <geom name="base_geom" type="sphere" size="0.02"/>

      <body name="thigh" pos="0 0 0">
        <joint name="hip_joint" type="hinge" axis="0 1 0" pos="0 0 0" range="-60 60" limited="true"/>
        <geom name="thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.05"/>

        <body name="shin" pos="0 0 -0.5">
          <joint name="knee_joint" type="hinge" axis="0 1 0" pos="0 0 0" range="-90 0" limited="true"/>
          <geom name="shin_geom" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.05"/>

          <body name="foot" pos="0 0 -0.5">
            <geom name="foot_geom" type="sphere" size="0.05"/>
            <site name="foot_site" pos="0 0 0" size="0.05"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="hip_pos_actuator" joint="hip_joint" kp="20" ctrlrange="-60 60"/>
    <velocity name="knee_vel_actuator" joint="knee_joint" kv="5" ctrlrange="-90 90"/>
  </actuator>

  <sensor>
    <touch name="foot_touch_sensor" site="foot_site"/>
    <jointpos name="hip_pos_sensor" joint="hip_joint"/>
    <jointvel name="knee_vel_sensor" joint="knee_joint"/>
  </sensor>
</mujoco>